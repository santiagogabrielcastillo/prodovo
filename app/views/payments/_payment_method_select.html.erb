<div>
  <%= form.label :payment_method, t("payments.form.payment_method"), class: "block text-sm font-medium text-gray-700 mb-1" %>
  <%= form.select :payment_method,
      Payment.payment_methods.keys.map { |m| [ I18n.t("payments.methods.#{m}"), m ] },
      { include_blank: t("payments.form.select_method") },
      required: true,
      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 text-base" %>
</div>
