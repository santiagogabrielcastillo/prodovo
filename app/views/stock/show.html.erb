<div class="space-y-8">

  <%# ─── HEADER ─── %>
  <div>
    <h1 class="text-2xl font-semibold text-slate-800"><%= t(".title") %></h1>
    <p class="text-sm text-slate-400 mt-1"><%= t(".subtitle") %></p>
  </div>

  <%# ─── CURRENT STOCK TABLE ─── %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-base font-semibold text-slate-700"><%= t(".current_stock_heading") %></h2>
    </div>

    <% if @products.empty? %>
      <p class="px-6 py-8 text-sm text-slate-400"><%= t(".no_stat_products") %></p>
    <% else %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs"><%= t(".product") %></th>
            <th class="px-6 py-3 text-right font-medium text-slate-500 uppercase tracking-wider text-xs"><%= t(".quantity") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @products.each do |product| %>
            <tr>
              <td class="px-6 py-3 font-medium text-slate-800"><%= product.name %></td>
              <td class="px-6 py-3 text-right font-semibold <%= product.current_stock < 0 ? 'text-red-600' : 'text-slate-800' %>">
                <%= number_with_precision(product.current_stock, precision: 2) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

    <%# ─── NEW ENTRY FORM ─── %>
    <div class="bg-white rounded-xl border border-gray-200 p-6">
      <h2 class="text-base font-semibold text-slate-700 mb-4"><%= t(".new_entry_heading") %></h2>

      <%= form_with model: @new_movement, url: stock_path, class: "space-y-4" do |f| %>
        <% if @new_movement.errors.any? %>
          <div class="rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700">
            <ul class="list-disc list-inside space-y-1">
              <% @new_movement.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"><%= t(".product") %></label>
          <%= f.select :product_id,
              options_from_collection_for_select(Product.for_stats.order(:name), :id, :name, @new_movement.product_id),
              { include_blank: t(".select_product") },
              class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"><%= t(".quantity") %></label>
          <%= f.text_field :quantity, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Ej: 50" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"><%= t(".date") %></label>
          <%= f.date_field :date, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1"><%= t(".notes") %></label>
          <%= f.text_area :notes, rows: 2, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Ej: Reposición de fábrica" %>
        </div>

        <div>
          <%= f.submit t(".submit"), class: "w-full inline-flex justify-center rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700 transition cursor-pointer" %>
        </div>
      <% end %>
    </div>

    <%# ─── MOVEMENT HISTORY ─── %>
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="text-base font-semibold text-slate-700"><%= t(".history_heading") %></h2>
      </div>

      <% if @movements.empty? %>
        <p class="px-6 py-8 text-sm text-slate-400"><%= t(".no_movements") %></p>
      <% else %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs"><%= t(".history_headers.date") %></th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs"><%= t(".history_headers.product") %></th>
                <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs"><%= t(".history_headers.type") %></th>
                <th class="px-4 py-3 text-right font-medium text-slate-500 uppercase tracking-wider text-xs"><%= t(".history_headers.quantity") %></th>
                <% unless current_user.stock_loader? %>
                  <th class="px-4 py-3 text-left font-medium text-slate-500 uppercase tracking-wider text-xs"><%= t(".history_headers.quote") %></th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @movements.each do |movement| %>
                <tr>
                  <td class="px-4 py-3 text-slate-600"><%= l(movement.date, format: :short) %></td>
                  <td class="px-4 py-3 font-medium text-slate-800"><%= movement.product.name %></td>
                  <td class="px-4 py-3 text-slate-600"><%= t("stock.show.movement_types.#{movement.movement_type}") %></td>
                  <td class="px-4 py-3 text-right font-semibold <%= movement.quantity < 0 ? 'text-red-600' : 'text-green-700' %>">
                    <%= movement.quantity > 0 ? "+" : "" %><%= number_with_precision(movement.quantity, precision: 2) %>
                  </td>
                  <% unless current_user.stock_loader? %>
                    <td class="px-4 py-3 text-slate-500">
                      <% if movement.quote %>
                        <%= link_to "##{movement.quote_id}", quote_path(movement.quote), class: "text-blue-600 hover:underline" %>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>

  </div>
</div>
