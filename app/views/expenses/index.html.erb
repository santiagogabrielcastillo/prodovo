<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .exp-serif { font-family: 'Fraunces', Georgia, serif; }
    .exp-ui    { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }

    .day-card { transition: box-shadow 0.2s ease, transform 0.15s ease; }
    .day-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,0.08); transform: translateY(-2px); }

    .expense-amount { font-family: 'Fraunces', Georgia, serif; font-variant-numeric: tabular-nums; }

    @keyframes slideInUp {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .day-card { animation: slideInUp 0.28s ease backwards; }
    .day-card:nth-child(1) { animation-delay: 0.03s; }
    .day-card:nth-child(2) { animation-delay: 0.07s; }
    .day-card:nth-child(3) { animation-delay: 0.11s; }
    .day-card:nth-child(4) { animation-delay: 0.15s; }
    .day-card:nth-child(5) { animation-delay: 0.19s; }
    .day-card:nth-child(6) { animation-delay: 0.23s; }
    .day-card:nth-child(7) { animation-delay: 0.27s; }

    .add-expense-btn { transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease; }
    .add-expense-btn:hover { background-color: #1e293b; border-color: #1e293b; color: white; }

    .week-nav-btn { transition: background-color 0.15s ease, color 0.15s ease; }
    .week-nav-btn:hover { background-color: #1e293b; color: white; }

    .today-card-header { background: linear-gradient(135deg, #1e293b 0%, #334155 100%); }

    .exp-action { transition: opacity 0.15s ease, color 0.15s ease; }
  </style>
<% end %>

<%
  today           = Date.current
  is_current_week = (@week_start <= today && today <= @week_end)
  week_total      = @expenses_by_date.values.flatten.sum(&:amount)
%>

<div class="w-full space-y-5 exp-ui">

  <%# ─── PAGE HEADER ─── %>
  <div class="flex flex-col gap-3">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <h1 class="text-2xl font-semibold text-slate-800 exp-serif tracking-tight"><%= t(".title") %></h1>
        <p class="text-sm text-slate-400 mt-0.5">
          <%= t(".week_range", from: l(@week_start, format: :long), to: l(@week_end, format: :long)) %>
        </p>
      </div>

      <div class="flex items-center gap-4">
        <% unless is_current_week %>
          <%= link_to t(".current_week"), expenses_path,
              class: "text-xs font-semibold px-3 py-1.5 rounded-full border border-indigo-300 text-indigo-600 hover:bg-indigo-50 transition" %>
        <% end %>
        <div class="text-right">
          <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold"><%= t(".total_amount") %></p>
          <p class="expense-amount text-3xl font-bold text-slate-800 leading-tight">
            $<%= number_with_precision(week_total, precision: 2) %>
          </p>
        </div>
      </div>
    </div>

    <%# Week navigation %>
    <div class="flex items-center gap-2">
      <%= link_to expenses_path(week_start: (@week_start - 7.days).to_s),
          class: "week-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 text-sm font-medium" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <%= t(".prev_week") %>
      <% end %>

      <%= link_to expenses_path(week_start: (@week_start + 7.days).to_s),
          class: "week-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 text-sm font-medium" do %>
        <%= t(".next_week") %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  </div>

  <%# ─── WEEKLY CALENDAR GRID ─── %>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-7 gap-3">
    <% (@week_start..@week_end).each do |day| %>
      <% day_expenses = @expenses_by_date[day] || [] %>
      <% day_total    = day_expenses.sum(&:amount) %>
      <% is_today     = (day == today) %>

      <div class="day-card bg-white rounded-xl border <%= is_today ? 'border-slate-700 shadow-md' : 'border-gray-200' %> flex flex-col overflow-hidden">

        <%# Day header %>
        <div class="<%= is_today ? 'today-card-header text-white' : 'bg-gray-50 text-slate-600' %> px-3 py-2.5">
          <div class="flex items-center justify-between">
            <p class="text-xs font-bold uppercase tracking-widest opacity-60 capitalize">
              <%= t("date.abbr_day_names")[day.wday] %>
            </p>
            <% if is_today %>
              <span class="text-xs font-semibold bg-white/20 text-white rounded-full px-2 py-0.5 leading-tight">
                <%= t(".today") %>
              </span>
            <% end %>
          </div>
          <p class="text-base font-semibold mt-0.5 exp-serif"><%= l(day, format: :short) %></p>
        </div>

        <%# Expense items %>
        <div class="flex-1 px-3 py-2">
          <% if day_expenses.empty? %>
            <div class="py-6 flex flex-col items-center justify-center">
              <div class="w-8 h-8 rounded-full border-2 border-dashed border-gray-300 flex items-center justify-center mb-2">
                <svg class="w-3.5 h-3.5 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                </svg>
              </div>
              <p class="text-xs text-gray-400 font-medium"><%= t(".no_expenses") %></p>
            </div>
          <% else %>
            <% day_expenses.each do |expense| %>
              <div class="py-2 border-b border-gray-100 last:border-0 group">
                <div class="flex items-start justify-between gap-1">
                  <p class="expense-amount text-lg font-semibold text-amber-800 leading-tight">
                    $<%= number_with_precision(expense.amount, precision: 2) %>
                  </p>
                  <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 exp-action pt-0.5">
                    <%= link_to edit_expense_path(expense, week_start: @week_start.to_s),
                        class: "text-gray-400 hover:text-indigo-600 exp-action" do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    <% end %>
                    <%= button_to expense_path(expense),
                        method: :delete,
                        form: { class: "inline-flex", data: { turbo_confirm: t("global.confirmations.delete") } },
                        class: "text-gray-400 hover:text-red-500 bg-transparent border-0 p-0 cursor-pointer exp-action" do %>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    <% end %>
                  </div>
                </div>
                <p class="text-xs text-slate-500 line-clamp-2 mt-0.5 leading-snug"><%= expense.description %></p>
              </div>
            <% end %>
          <% end %>
        </div>

        <%# Card footer: daily total + add button %>
        <div class="px-3 pb-3 pt-1 space-y-2">
          <div class="flex items-center justify-between border-t border-gray-100 pt-2">
            <span class="text-xs text-gray-400 uppercase tracking-wider font-semibold"><%= t(".day_total") %></span>
            <span class="expense-amount text-sm font-bold text-slate-700">
              $<%= number_with_precision(day_total, precision: 2) %>
            </span>
          </div>

          <%= link_to new_expense_path(date: day.to_s, week_start: @week_start.to_s),
              class: "add-expense-btn flex items-center justify-center gap-1.5 w-full py-2 rounded-lg border border-dashed border-gray-300 text-gray-400 text-xs font-semibold" do %>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <%= t(".add_expense") %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

</div>
