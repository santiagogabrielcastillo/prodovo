<div class="w-full space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <h1 class="text-3xl font-bold text-gray-900"><%= t(".title") %></h1>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to t(".prev_week"),
          expenses_path(week_start: (@week_start - 7.days).to_s),
          class: "px-3 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50 text-sm font-medium" %>
      <%= link_to t(".next_week"),
          expenses_path(week_start: (@week_start + 7.days).to_s),
          class: "px-3 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50 text-sm font-medium" %>
    </div>
  </div>

  <p class="text-sm text-gray-600">
    <%= t(".week_range", from: l(@week_start, format: :long), to: l(@week_end, format: :long)) %>
  </p>

  <div class="grid grid-cols-1 md:grid-cols-7 gap-4">
    <% (@week_start..@week_end).each do |day| %>
      <% day_expenses = @expenses_by_date[day] || [] %>
      <div class="bg-white shadow rounded-lg border border-gray-100 flex flex-col min-h-[12rem]">
        <div class="px-3 py-2 border-b border-gray-100 bg-gray-50 rounded-t-lg">
          <p class="text-xs font-semibold text-gray-500 capitalize"><%= t("date.day_names")[day.wday] %></p>
          <p class="text-sm font-medium text-gray-900"><%= l(day, format: :short) %></p>
        </div>
        <div class="flex-1 px-3 py-2 space-y-2 text-sm">
          <% day_expenses.each do |expense| %>
            <div class="border-b border-gray-100 last:border-0 pb-2 last:pb-0">
              <p class="font-medium text-gray-900">$<%= number_with_precision(expense.amount, precision: 2) %></p>
              <p class="text-gray-600 line-clamp-3"><%= expense.description %></p>
              <div class="mt-1 flex gap-2 text-xs">
                <%= link_to t("global.actions.edit"), edit_expense_path(expense, week_start: @week_start.to_s), class: "text-indigo-600 hover:text-indigo-900" %>
                <%= button_to t("global.actions.delete"), expense_path(expense),
                    method: :delete,
                    form: { class: "inline-block", data: { turbo_confirm: t("global.confirmations.delete") } },
                    class: "text-red-600 hover:text-red-800 bg-transparent border-0 p-0 cursor-pointer text-xs align-top" %>
              </div>
            </div>
          <% end %>
        </div>
        <div class="px-3 py-2 border-t border-gray-100 mt-auto">
          <%= link_to t(".add_expense"), new_expense_path(date: day.to_s, week_start: @week_start.to_s), class: "block w-full text-center text-sm font-medium px-2 py-2 rounded bg-indigo-600 text-white hover:bg-indigo-700" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
