<%= form_with(model: expense, class: "space-y-6") do |form| %>
  <% if expense.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 p-4 rounded">
      <p class="font-semibold mb-2"><%= t("expenses.form.errors_header") %></p>
      <ul class="list-disc list-inside text-sm">
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :date, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.date_field :date, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 text-base" %>
  </div>

  <div>
    <%= form.label :amount, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.number_field :amount,
        step: 0.01,
        class: "no-spinner mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 text-base" %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :description, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 text-base" %>
  </div>

  <div class="flex flex-wrap justify-end gap-3 pt-4 border-t border-gray-200">
    <%= link_to t("global.actions.cancel"), expenses_path(week_start: local_assigns[:week_start]), class: "px-4 py-2 rounded border border-gray-300 text-gray-700 hover:bg-gray-50" %>
    <%= form.submit t("global.actions.save"), class: "px-4 py-2 rounded bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer" %>
  </div>
<% end %>
