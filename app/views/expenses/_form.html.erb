<%= form_with(model: expense, class: "space-y-5 exp-ui") do |form| %>
  <% if expense.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-400 text-red-700 p-4 rounded-r-lg">
      <p class="font-semibold text-sm mb-1"><%= t("expenses.form.errors_header") %></p>
      <ul class="list-disc list-inside text-sm space-y-0.5">
        <% expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-1">
    <%= form.label :date, class: "block text-xs font-bold text-slate-400 uppercase tracking-widest" %>
    <%= form.date_field :date,
        class: "mt-1 block w-full rounded-lg border-gray-200 bg-gray-50 focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 text-base text-slate-800" %>
  </div>

  <div class="space-y-1">
    <%= form.label :amount, class: "block text-xs font-bold text-slate-400 uppercase tracking-widest" %>
    <div class="relative mt-1">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-medium text-lg select-none">$</span>
      <%= form.number_field :amount,
          step: 0.01,
          class: "no-spinner block w-full rounded-lg border-gray-200 bg-gray-50 focus:border-indigo-500 focus:ring-indigo-500 py-3 pl-8 pr-4 text-xl font-semibold text-slate-800" %>
    </div>
  </div>

  <div class="space-y-1">
    <%= form.label :description, class: "block text-xs font-bold text-slate-400 uppercase tracking-widest" %>
    <%= form.text_area :description, rows: 3,
        class: "mt-1 block w-full rounded-lg border-gray-200 bg-gray-50 focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 text-base text-slate-800 resize-none" %>
  </div>

  <div class="space-y-1">
    <%= form.label :payment_method, t("expenses.form.payment_method"), class: "block text-xs font-bold text-slate-400 uppercase tracking-widest" %>
    <%= form.select :payment_method,
        Expense.payment_methods.keys.map { |m| [ I18n.t("payments.methods.#{m}"), m ] },
        { include_blank: t("expenses.form.select_method") },
        class: "mt-1 block w-full rounded-lg border-gray-200 bg-gray-50 focus:border-indigo-500 focus:ring-indigo-500 py-3 px-4 text-base text-slate-800" %>
  </div>

  <div class="flex flex-wrap justify-end gap-3 pt-4 border-t border-gray-100">
    <%= link_to t("global.actions.cancel"), expenses_path(week_start: local_assigns[:week_start]),
        class: "px-5 py-2.5 rounded-lg border border-gray-200 text-slate-600 hover:bg-gray-50 text-sm font-medium transition" %>
    <%= form.submit t("global.actions.save"),
        class: "px-5 py-2.5 rounded-lg bg-slate-800 text-white hover:bg-slate-700 text-sm font-semibold cursor-pointer transition" %>
  </div>
<% end %>
