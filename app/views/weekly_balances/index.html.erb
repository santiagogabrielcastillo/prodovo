<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .wb-serif { font-family: 'Fraunces', Georgia, serif; }
    .wb-ui   { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    .wb-num  { font-family: 'Fraunces', Georgia, serif; font-variant-numeric: tabular-nums; }
    .week-nav-btn { transition: background-color 0.15s ease, color 0.15s ease; }
    .week-nav-btn:hover { background-color: #1e293b; color: white; }
  </style>
<% end %>

<%
  today           = Date.current
  is_current_week = (@week_start <= today && today <= @week_end)
%>

<div class="w-full space-y-4 wb-ui">

  <%# Compact header %>
  <div class="flex items-center justify-between gap-4">
    <div class="flex items-baseline gap-3">
      <h1 class="text-xl font-semibold text-slate-800 wb-serif tracking-tight"><%= t(".title") %></h1>
      <span class="text-sm text-slate-500">
        <%= t(".week_range", from: l(@week_start, format: :long), to: l(@week_end, format: :long)) %>
      </span>
    </div>

    <div class="flex items-center gap-2">
      <% unless is_current_week %>
        <%= link_to t(".current_week"), weekly_balances_path,
            class: "text-xs font-semibold px-3 py-1.5 rounded-full border border-indigo-300 text-indigo-600 hover:bg-indigo-50 transition" %>
      <% end %>
      
      <%= link_to weekly_balances_path(week_start: (@week_start - 7.days).to_s),
          class: "week-nav-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-slate-200 text-slate-600 text-xs font-medium" do %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <%= t(".prev_week") %>
      <% end %>

      <%= link_to weekly_balances_path(week_start: (@week_start + 7.days).to_s),
          class: "week-nav-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-md border border-slate-200 text-slate-600 text-xs font-medium" do %>
        <%= t(".next_week") %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  </div>

  <%# Compact metrics strip %>
  <div class="grid grid-cols-5 gap-2">
    <div class="rounded-lg border border-slate-200 bg-white px-3 py-2">
      <p class="text-xs text-slate-500 font-medium"><%= t(".payments_total") %></p>
      <p class="wb-num text-sm font-bold text-emerald-800 whitespace-nowrap">
        $<%= number_with_precision(@payments_total, precision: 2) %>
      </p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white px-3 py-2">
      <p class="text-xs text-slate-500 font-medium"><%= t(".expenses_total") %></p>
      <p class="wb-num text-sm font-bold text-amber-800 whitespace-nowrap">
        $<%= number_with_precision(@expenses_total, precision: 2) %>
      </p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-slate-900 px-3 py-2 text-white">
      <p class="text-xs text-white/70 font-medium"><%= t(".net_total") %></p>
      <p class="wb-num text-sm font-bold whitespace-nowrap <%= @net_total.negative? ? 'text-rose-300' : 'text-white' %>">
        $<%= number_with_precision(@net_total, precision: 2) %>
      </p>
    </div>
    <div class="rounded-lg border border-indigo-200 bg-indigo-950 px-3 py-2 text-white">
      <p class="text-xs text-indigo-300/80 font-medium"><%= t(".cumulative_net") %></p>
      <p class="wb-num text-sm font-bold whitespace-nowrap <%= @cumulative_net.negative? ? 'text-rose-300' : 'text-indigo-100' %>">
        $<%= number_with_precision(@cumulative_net, precision: 2) %>
      </p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white px-3 py-2">
      <p class="text-xs text-slate-500 font-medium"><%= t(".units_sold") %></p>
      <p class="wb-num text-sm font-bold text-slate-800 whitespace-nowrap">
        <%= number_with_precision(@units_sold, precision: 2, strip_insignificant_zeros: true) %>
      </p>
    </div>
  </div>

  <%# Payment methods breakdown (collapsible) %>
  <details class="group">
    <summary class="cursor-pointer list-none flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition">
      <span><%= t(".payments_by_method_heading") %></span>
      <svg class="w-4 h-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </summary>
    <div class="mt-2 rounded-lg border border-slate-200 bg-white p-4">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-100">
            <th class="text-left text-xs font-semibold text-slate-400 uppercase tracking-wider pb-2"><%= t(".method_name") %></th>
            <th class="text-right text-xs font-semibold text-slate-400 uppercase tracking-wider pb-2"><%= t(".method_payments") %></th>
            <th class="text-right text-xs font-semibold text-slate-400 uppercase tracking-wider pb-2"><%= t(".method_balance") %></th>
          </tr>
        </thead>
        <tbody>
          <% Payment.payment_methods.each_key do |method_key| %>
            <% payments = @payments_by_method[method_key] || 0 %>
            <% balance = @balance_by_method[method_key] || 0 %>
            <tr class="border-b border-slate-50 last:border-0">
              <td class="py-1.5 text-slate-600"><%= t("payments.methods.#{method_key}") %></td>
              <td class="py-1.5 text-right wb-num font-semibold text-slate-800 whitespace-nowrap">$<%= number_with_precision(payments, precision: 2) %></td>
              <td class="py-1.5 text-right wb-num font-semibold whitespace-nowrap <%= balance.negative? ? 'text-rose-700' : 'text-emerald-700' %>">$<%= number_with_precision(balance, precision: 2) %></td>
            </tr>
          <% end %>
          <% if @payments_by_method.key?(nil) || @expenses_by_method.key?(nil) || @balance_by_method.key?(nil) %>
            <% payments_nil = @payments_by_method[nil] || 0 %>
            <% balance_nil = @balance_by_method[nil] || 0 %>
            <tr class="border-b border-slate-50 last:border-0">
              <td class="py-1.5 text-slate-400 italic"><%= t(".unclassified_method") %></td>
              <td class="py-1.5 text-right wb-num font-semibold text-slate-400 whitespace-nowrap">$<%= number_with_precision(payments_nil, precision: 2) %></td>
              <td class="py-1.5 text-right wb-num font-semibold whitespace-nowrap <%= balance_nil.negative? ? 'text-rose-700' : 'text-emerald-700' %>">$<%= number_with_precision(balance_nil, precision: 2) %></td>
            </tr>
          <% end %>
          <tr class="border-t border-slate-100 font-semibold">
            <td class="py-2 text-slate-700"><%= t(".payments_by_method_total") %></td>
            <td class="py-2 text-right wb-num font-bold text-emerald-800 whitespace-nowrap">$<%= number_with_precision(@payments_total, precision: 2) %></td>
            <td class="py-2 text-right wb-num font-bold text-emerald-800 whitespace-nowrap">$<%= number_with_precision(@balance_by_method.values.sum, precision: 2) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </details>

  <%# Daily net — the hero %>
  <div>
    <h2 class="text-xs font-semibold text-slate-600 uppercase tracking-wider mb-2"><%= t(".daily_net_heading") %></h2>
    <div class="grid grid-cols-7 gap-2">
      <% @daily_nets.each do |row| %>
        <% day = row[:day] %>
        <% is_today = (day == today) %>
        <% details_id = "day-balance-details-#{day.iso8601}" %>
        <div
          class="rounded-lg border <%= is_today ? 'border-slate-700 bg-slate-50 shadow-sm' : 'border-slate-200 bg-white' %> flex flex-col overflow-hidden"
          data-controller="weekly-day-balance">
          <button
            type="button"
            class="w-full px-2.5 py-2 text-left hover:bg-slate-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 transition"
            data-weekly-day-balance-target="trigger"
            data-action="weekly-day-balance#toggle"
            aria-expanded="false"
            aria-controls="<%= details_id %>">
            <div class="flex items-center justify-between gap-1">
              <div class="min-w-0 flex-1">
                <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">
                  <%= t("date.abbr_day_names")[day.wday] %>
                  <% if is_today %>
                    <span class="ml-1 text-indigo-600 normal-case">· <%= t(".today") %></span>
                  <% end %>
                </p>
                <p class="text-xs text-slate-400"><%= l(day, format: :short) %></p>
              </div>
              <svg class="w-3 h-3 text-slate-400 shrink-0 transition-transform duration-200" data-weekly-day-balance-target="caret" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
            <p class="wb-num text-sm font-bold mt-1.5 whitespace-nowrap <%= row[:net].negative? ? 'text-rose-700' : 'text-slate-800' %>">
              $<%= number_with_precision(row[:net], precision: 2) %>
            </p>
          </button>

          <div
            id="<%= details_id %>"
            data-weekly-day-balance-target="details"
            class="hidden border-t border-slate-200 bg-white px-2.5 pb-3 pt-2 space-y-1.5 max-h-48 overflow-y-auto text-xs">
            <div class="rounded bg-emerald-50 border border-emerald-100 p-2" role="region">
              <% if row[:payment_records].empty? %>
                <span class="text-emerald-700/60 italic"><%= t(".no_payments") %></span>
              <% else %>
                <ul class="space-y-1">
                  <% row[:payment_records].each do |payment| %>
                    <li class="leading-tight">
                      <span class="wb-num font-semibold text-emerald-900 whitespace-nowrap">$<%= number_with_precision(payment.amount, precision: 2) %></span>
                      <span class="text-emerald-800/80"> · <%= payment.client.name %></span>
                      <% if payment.notes.present? %>
                        <span class="block text-emerald-700/70 mt-0.5 text-xs"><%= truncate(payment.notes, length: 60) %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>

            <div class="rounded bg-amber-50 border border-amber-100 p-2" role="region">
              <% if row[:expense_records].empty? %>
                <span class="text-amber-700/60 italic"><%= t(".no_expenses") %></span>
              <% else %>
                <ul class="space-y-1">
                  <% row[:expense_records].each do |expense| %>
                    <li class="leading-tight">
                      <span class="wb-num font-semibold text-amber-900 whitespace-nowrap">$<%= number_with_precision(expense.amount, precision: 2) %></span>
                      <span class="text-amber-800/80"> · <%= expense.description %></span>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
