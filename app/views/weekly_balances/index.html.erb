<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    .wb-serif { font-family: 'Fraunces', Georgia, serif; }
    .wb-ui   { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; }
    .wb-num  { font-family: 'Fraunces', Georgia, serif; font-variant-numeric: tabular-nums; }
    .week-nav-btn { transition: background-color 0.15s ease, color 0.15s ease; }
    .week-nav-btn:hover { background-color: #1e293b; color: white; }
  </style>
<% end %>

<%
  today           = Date.current
  is_current_week = (@week_start <= today && today <= @week_end)
%>

<div class="w-full space-y-6 wb-ui">

  <div class="flex flex-col gap-3">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <h1 class="text-2xl font-semibold text-slate-800 wb-serif tracking-tight"><%= t(".title") %></h1>
        <p class="text-sm text-slate-500 mt-0.5"><%= t(".subtitle") %></p>
        <p class="text-sm text-slate-400 mt-1">
          <%= t(".week_range", from: l(@week_start, format: :long), to: l(@week_end, format: :long)) %>
        </p>
      </div>

      <div class="flex items-center gap-4">
        <% unless is_current_week %>
          <%= link_to t(".current_week"), weekly_balances_path,
              class: "text-xs font-semibold px-3 py-1.5 rounded-full border border-indigo-300 text-indigo-600 hover:bg-indigo-50 transition" %>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to weekly_balances_path(week_start: (@week_start - 7.days).to_s),
          class: "week-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 text-sm font-medium" do %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <%= t(".prev_week") %>
      <% end %>

      <%= link_to weekly_balances_path(week_start: (@week_start + 7.days).to_s),
          class: "week-nav-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 text-slate-600 text-sm font-medium" do %>
        <%= t(".next_week") %>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  </div>

  <%# Weekly totals (total_amount strip) %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold"><%= t(".payments_total") %></p>
      <p class="wb-num text-2xl font-bold text-emerald-800 mt-1">
        $<%= number_with_precision(@payments_total, precision: 2) %>
      </p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold"><%= t(".expenses_total") %></p>
      <p class="wb-num text-2xl font-bold text-amber-800 mt-1">
        $<%= number_with_precision(@expenses_total, precision: 2) %>
      </p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-slate-900 p-4 shadow-sm text-white">
      <p class="text-xs text-white/60 uppercase tracking-widest font-semibold"><%= t(".net_total") %></p>
      <p class="wb-num text-2xl font-bold mt-1 <%= @net_total.negative? ? 'text-rose-300' : 'text-white' %>">
        $<%= number_with_precision(@net_total, precision: 2) %>
      </p>
    </div>
  </div>

  <%# Daily net %>
  <div>
    <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wider mb-3"><%= t(".daily_net_heading") %></h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-7 gap-3">
      <% @daily_nets.each do |row| %>
        <% day = row[:day] %>
        <% is_today = (day == today) %>
        <% details_id = "day-balance-details-#{day.iso8601}" %>
        <div
          class="rounded-xl border <%= is_today ? 'border-slate-700 bg-slate-50 shadow-md' : 'border-slate-200 bg-white' %> flex flex-col overflow-hidden"
          data-controller="weekly-day-balance">
          <button
            type="button"
            class="w-full p-3 text-left hover:bg-slate-100/70 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 transition <%= is_today ? 'bg-slate-50/80' : 'bg-white' %>"
            data-weekly-day-balance-target="trigger"
            data-action="weekly-day-balance#toggle"
            aria-expanded="false"
            aria-controls="<%= details_id %>">
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <p class="text-xs font-bold uppercase tracking-widest text-slate-400 capitalize">
                  <%= t("date.abbr_day_names")[day.wday] %>
                </p>
                <p class="text-sm font-semibold text-slate-700 wb-serif"><%= l(day, format: :short) %></p>
                <% if is_today %>
                  <span class="text-xs font-semibold text-slate-600 mt-1 inline-block"><%= t(".today") %></span>
                <% end %>
              </div>
              <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5 transition-transform duration-200" data-weekly-day-balance-target="caret" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
            <p class="wb-num text-lg font-bold mt-2 <%= row[:net].negative? ? 'text-rose-700' : 'text-slate-800' %>">
              $<%= number_with_precision(row[:net], precision: 2) %>
            </p>
            <p class="text-xs text-indigo-600 font-medium mt-2"><%= t(".expand_hint") %></p>
          </button>

          <div
            id="<%= details_id %>"
            data-weekly-day-balance-target="details"
            class="hidden border-t border-slate-200 bg-white px-4 pb-8 pt-3 space-y-2 max-h-56 overflow-y-auto min-w-0 scroll-pb-4">
            <div class="rounded-lg bg-emerald-50/70 border border-emerald-100/80 p-2.5 min-w-0" role="region">
              <% if row[:payment_records].empty? %>
                <span class="sr-only"><%= t(".no_payments") %></span>
              <% else %>
                <ul class="space-y-1.5 min-w-0 pr-0.5">
                  <% row[:payment_records].each do |payment| %>
                    <li class="text-xs leading-snug break-words">
                      <span class="wb-num font-semibold text-emerald-900">$<%= number_with_precision(payment.amount, precision: 2) %></span>
                      <span class="text-emerald-800/80"> · <%= payment.client.name %></span>
                      <% if payment.notes.present? %>
                        <span class="block text-emerald-700/70 mt-0.5"><%= truncate(payment.notes, length: 80) %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>

            <div class="rounded-lg bg-amber-50/70 border border-amber-100/80 p-2.5 min-w-0" role="region">
              <% if row[:expense_records].empty? %>
                <span class="sr-only"><%= t(".no_expenses") %></span>
              <% else %>
                <ul class="space-y-1.5 min-w-0 pr-0.5">
                  <% row[:expense_records].each do |expense| %>
                    <li class="text-xs leading-snug break-words">
                      <span class="wb-num font-semibold text-amber-900">$<%= number_with_precision(expense.amount, precision: 2) %></span>
                      <span class="text-amber-800/80"> · <%= expense.description %></span>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
