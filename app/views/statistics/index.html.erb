<div class="w-full space-y-6">
  <!-- Header -->
  <div>
    <h1 class="text-3xl font-bold text-gray-900"><%= t('statistics.index.title') %></h1>
    <p class="text-gray-600 mt-2"><%= t('statistics.index.subtitle') %></p>
  </div>

  <!-- Date filter (presets + custom range; Turbo Drive with scroll preserved) -->
  <div class="bg-white shadow rounded-lg p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('statistics.index.date_filter') %></h2>
    <% preset_link_params = @selected_product.present? ? { product_id: @selected_product.id } : {} %>
    <%= form_with url: statistics_path, method: :get, class: "space-y-4", data: { turbo_preserve_scroll: true } do |f| %>
      <div class="flex flex-wrap gap-2 mb-4">
        <% %w[this_month last_3_months this_year].each do |preset_key| %>
          <% active = @current_preset == preset_key %>
          <% link_class = active ? "px-3 py-1.5 rounded-md border-2 border-indigo-500 bg-indigo-50 text-indigo-800 text-sm font-semibold" : "px-3 py-1.5 rounded-md border border-gray-300 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
          <%= link_to t("statistics.index.preset_#{preset_key}"), statistics_path(preset: preset_key, **preset_link_params), class: link_class, data: { turbo_preserve_scroll: true } %>
        <% end %>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 items-end">
        <%= f.hidden_field :product_id, value: @selected_product&.id if @selected_product.present? %>
        <div class="flex-1 min-w-0">
          <label for="start_date" class="block text-sm font-medium text-gray-700 mb-1"><%= t('statistics.index.start_date') %></label>
          <input type="date" name="start_date" id="start_date" value="<%= @start_date&.strftime('%Y-%m-%d') %>" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 text-sm">
        </div>
        <div class="flex-1 min-w-0">
          <label for="end_date" class="block text-sm font-medium text-gray-700 mb-1"><%= t('statistics.index.end_date') %></label>
          <input type="date" name="end_date" id="end_date" value="<%= @end_date&.strftime('%Y-%m-%d') %>" class="w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 py-2 px-3 text-sm">
        </div>
        <div>
          <%= f.submit t('statistics.index.apply'), class: "px-4 py-2 rounded bg-indigo-600 text-white hover:bg-indigo-700 font-medium cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>

  <% unless @has_sales %>
    <p class="text-gray-500 text-sm"><%= t('statistics.index.no_sales') %></p>
  <% end %>

  <!-- KPI cards (3 only; product stats moved below) -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <div class="bg-white shadow rounded-lg p-6">
      <p class="text-sm font-medium text-gray-500 mb-2"><%= t('statistics.index.total_financial_sales') %></p>
      <p class="text-4xl font-bold text-green-600">$<%= number_with_precision(@total_financial_sales, precision: 0) %></p>
      <p class="text-xs text-gray-500 mt-2"><%= t('statistics.index.total_financial_sales_hint') %></p>
    </div>
    <div class="bg-white shadow rounded-lg p-6">
      <p class="text-sm font-medium text-gray-500 mb-2"><%= t('statistics.index.total_pure_quantity') %></p>
      <p class="text-4xl font-bold text-gray-900"><%= number_with_precision(@total_pure_quantity, precision: 2) %></p>
      <p class="text-xs text-gray-500 mt-2"><%= t('statistics.index.total_pure_quantity_hint') %></p>
    </div>
    <div class="bg-white shadow rounded-lg p-6">
      <p class="text-sm font-medium text-gray-500 mb-2"><%= t('statistics.index.avg_price_all_pure') %></p>
      <p class="text-4xl font-bold text-gray-900">$<%= number_with_precision(@avg_price_all_pure, precision: 2) %></p>
      <p class="text-xs text-gray-500 mt-2"><%= t('statistics.index.avg_price_all_pure_hint') %></p>
    </div>
  </div>

  <!-- Product participation breakdown -->
  <div class="bg-white shadow rounded-lg p-6 w-full">
    <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('statistics.index.product_breakdown_heading') %></h2>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 py-3 text-left font-semibold text-gray-500 uppercase tracking-wider"><%= t('statistics.index.product_breakdown_product') %></th>
            <th class="px-4 py-3 text-right font-semibold text-gray-500 uppercase tracking-wider"><%= t('statistics.index.product_breakdown_units') %></th>
            <th class="px-4 py-3 text-right font-semibold text-gray-500 uppercase tracking-wider"><%= t('statistics.index.product_breakdown_share') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @products.each do |product| %>
            <% qty = @qty_by_product[product.id] || 0 %>
            <% share = @total_pure_quantity.positive? ? number_with_precision(qty / @total_pure_quantity * 100, precision: 1) : "—" %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 text-gray-900"><%= product.name %></td>
              <td class="px-4 py-3 text-right text-gray-700"><%= number_with_precision(qty, precision: 0) %></td>
              <td class="px-4 py-3 text-right font-semibold text-indigo-700"><%= share == "—" ? share : "#{share}%" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Full-width: Product statistics (Turbo Frame so selecting a product doesn't scroll the page) -->
  <%= turbo_frame_tag "product_stats" do %>
    <div class="bg-white shadow rounded-lg p-6 w-full">
      <h2 class="text-lg font-semibold text-gray-900 mb-4"><%= t('statistics.index.specific_product') %></h2>
      <%= form_with url: statistics_path, method: :get, class: "mb-6", data: { controller: "magic-selector", turbo_frame: "product_stats" } do |f| %>
        <%= f.hidden_field :start_date, value: @start_date&.strftime('%Y-%m-%d') %>
        <%= f.hidden_field :end_date, value: @end_date&.strftime('%Y-%m-%d') %>
        <div class="flex flex-col sm:flex-row gap-4 items-end max-w-md">
          <div class="flex-1 min-w-0">
            <label for="product_id" class="block text-sm font-medium text-gray-700 mb-1"><%= t('statistics.index.product_selector') %></label>
            <%= f.select :product_id, options_from_collection_for_select(@products, :id, :name, @selected_product&.id), { include_blank: t('statistics.index.product_selector_placeholder') }, { class: "w-full rounded-md border-gray-300 shadow-sm text-sm p-2", data: { magic_selector_target: "select" } } %>
          </div>
        </div>
      <% end %>

      <% if @selected_product %>
        <div class="border-t border-gray-200 pt-6">
          <p class="text-xl font-bold text-indigo-600 mb-4"><%= @selected_product.name %></p>
          <p class="text-sm text-gray-500 mb-4"><%= t('statistics.index.stats_in_period') %>: <%= l(@start_date, format: :short) %> – <%= l(@end_date, format: :short) %></p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-2xl">
            <div class="bg-gray-50 rounded-lg p-5 border border-gray-200">
              <p class="text-sm font-medium text-gray-500 mb-1"><%= t('statistics.index.avg_price_product') %></p>
              <p class="text-3xl font-bold text-gray-900">$<%= number_with_precision(@product_avg_price, precision: 2) %></p>
            </div>
            <div class="bg-gray-50 rounded-lg p-5 border border-gray-200">
              <p class="text-sm font-medium text-gray-500 mb-1"><%= t('statistics.index.quantity_product') %></p>
              <p class="text-3xl font-bold text-gray-900"><%= number_with_precision(@product_quantity, precision: 2) %></p>
            </div>
          </div>
        </div>
      <% else %>
        <p class="text-gray-500 text-sm"><%= t('statistics.index.product_selector_placeholder') %></p>
      <% end %>
    </div>
  <% end %>
</div>
